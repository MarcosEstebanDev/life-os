# --- LLM: local por defecto (Ollama). Un proveedor remoto exige LLM_ALLOW_REMOTE=true ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_ALLOW_REMOTE=false
# Por pedido, incluida la carga del modelo en frío (en un disco lento tarda minutos). Default: 1800000 (30 min)
# LLM_TIMEOUT_MS=1800000

# --- Base de datos y cola (docker compose) ---
DATABASE_URL=postgresql://lifeos:lifeos@localhost:5434/life_os
REDIS_URL=redis://localhost:6381

# --- Carpeta observada y API ---
WATCH_DIR=./.local/inbox

# Zona IANA que define "hoy" para los vencimientos. UTC si no se pone.
# TIME_ZONE=America/Sao_Paulo
PORT=3010

# --- Autenticación ---
# 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=
WEB_ORIGINS=http://localhost:3011,http://127.0.0.1:3011
# first: sólo la primera cuenta · true: abierto · false: cerrado
ALLOW_SIGNUP=first
# Dueño de la carpeta observada: el email con el que te registraste (el worker lo fija al arrancar)
WATCH_OWNER_EMAIL=
