// Prisma 7: `prisma-client` (ESM) con output explícito.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocumentStatus {
  PENDING
  TEXT_EXTRACTED
  PROCESSED
  FAILED
}

enum ObligationKind {
  PAYMENT
  RENEWAL
  DEADLINE
  EXPIRY
  OTHER
}

enum Recurrence {
  NONE
  MONTHLY
  YEARLY
}

enum ObligationStatus {
  PROPOSED
  ACTIVE
  DONE
  DISMISSED
}

model Document {
  id          String         @id @default(uuid()) @db.Uuid
  path        String
  sha256      String         @unique
  mimeType    String         @map("mime_type")
  sizeBytes   Int            @map("size_bytes")
  status      DocumentStatus
  error       String?
  text        String?
  createdAt   DateTime       @default(now()) @map("created_at")
  obligations Obligation[]

  @@map("documents")
}

model Obligation {
  id               String           @id @db.Uuid
  title            String
  kind             ObligationKind
  // Sólo fecha: un vencimiento es un día, no un instante.
  dueDate          DateTime?        @map("due_date") @db.Date
  recurrence       Recurrence
  amount           Decimal?         @db.Decimal(12, 2)
  currency         String?
  counterparty     String?
  sourceDocumentId String           @map("source_document_id") @db.Uuid
  sourceDocument   Document         @relation(fields: [sourceDocumentId], references: [id])
  evidence         String[]
  confidence       Float
  status           ObligationStatus
  seriesKey        String           @map("series_key")
  possibleUpdateOf String?          @map("possible_update_of") @db.Uuid
  doneAt           DateTime?        @map("done_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  @@index([seriesKey])
  @@index([status])
  @@map("obligations")
}
