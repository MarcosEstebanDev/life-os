{
  "name": "life-os",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Second Brain + Life Dashboard: obligaciones extraídas de mis papeles y un brief diario",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "llm:smoke": "tsx --env-file-if-exists=.env src/llm-smoke.ts",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:smoke": "tsx --env-file=.env src/db-smoke.ts",
    "worker": "tsx --env-file=.env src/worker/main.ts",
    "api": "tsx --env-file=.env src/api/main.ts",
    "web": "npm --prefix apps/web run dev",
    "web:install": "npm --prefix apps/web install",
    "web:build": "npm --prefix apps/web run build",
    "dev": "concurrently -k -n worker,api,web -c blue,green,magenta \"npm:worker\" \"npm:api\" \"npm:web\"",
    "db:deploy": "prisma migrate deploy && prisma generate"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "concurrently": "^9.2.5",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.43.1",
    "bullmq": "^6.5.0",
    "chokidar": "^4.0.3",
    "exceljs": "4.4.0",
    "ioredis": "^6.0.0",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  }
}
